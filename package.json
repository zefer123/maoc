{
  "name": "multi-agent-topology-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:dashboard:browser": "node server/scripts/dashboard-browser.mjs",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"server/src/**/*.js\"",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test:frontend": "node --test test/frontendHelpers.test.js",
    "verify": "npm run lint && npm run typecheck && npm run test:frontend && npm --prefix server test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "10.16.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "^6.0.0"
  }
}
