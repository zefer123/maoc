# Copy to .env in the project root. Never prefix server secrets with VITE_.
PORT=8787
HOST=127.0.0.1
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
WEBHOOK_URL=
VAULT_DIR=./vault
# Defaults preserve JSON. SQLite requires a separately rehearsed, complete Vault.
# Import is offline-only through server/scripts/vault-admin.mjs; never implicit here.
MAOC_STORAGE_DRIVER=atomic-json
# Use false for maintenance/first boot. Persisted schedules still require Resume.
MAOC_SCHEDULER_AUTOSTART=true
# Opt in after a verified rollout. False keeps collection polling and task telemetry.
MAOC_COLLECTION_REALTIME=false
# Access keys are local-only. Generate a high-entropy Admin Key before enabling.
# Keep both the Dashboard and API on loopback; do not expose a reverse proxy.
MAOC_ACCESS_GATE=false
MAOC_ADMIN_KEY=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# Shared fixed window for local REST /api requests; separate from provider RPM.
MAOC_REST_REQUESTS_PER_MINUTE=600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional frontend override for a separately hosted backend; contains no secrets.
VITE_API_BASE_URL=http://localhost:8787